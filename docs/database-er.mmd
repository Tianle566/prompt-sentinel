erDiagram
    USERS ||--o{ REQUEST_LOGS : creates
    USERS ||--o{ EVALUATION_JOBS : launches
    USERS ||--o{ POLICY_AUDITS : changes
    USERS ||--o{ ADMIN_AUDITS : operates
    USERS ||--o{ CUSTOM_SAMPLES : maintains
    USERS {
        int id PK
        string username UK
        string password_hash
        string role
        bool is_active
        int session_version
        datetime created_at
    }
    REQUEST_LOGS {
        int id PK
        int user_id FK
        string kind
        text text
        bool protected
        bool blocked
        string attack_type
        json hit_layers
        float latency_ms
        json result
        datetime created_at
    }
    EVALUATION_JOBS {
        string id PK
        int user_id FK
        string experiment
        string status
        float progress
        text message
        json config
        json result
        text error
        bool cancel_requested
        bool archived
        datetime created_at
        datetime updated_at
    }
    POLICY_AUDITS {
        int id PK
        int user_id FK
        json before
        json after
        datetime created_at
    }
    ADMIN_AUDITS {
        int id PK
        int user_id FK
        string action
        string target
        json details
        datetime created_at
    }
    CUSTOM_SAMPLES {
        string id PK
        int user_id FK
        text text
        string lang
        string attack_type
        int label
        string source
        json oracle
        bool enabled
        datetime created_at
        datetime updated_at
    }
